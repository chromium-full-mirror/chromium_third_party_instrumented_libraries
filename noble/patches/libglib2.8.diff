diff --git a/glib/gstdio.c b/glib/gstdio.c
index b4e1971..9aef6fa 100644
--- a/glib/gstdio.c
+++ b/glib/gstdio.c
@@ -1281,6 +1281,8 @@ g_chdir (const gchar *path)
 #endif
 }
 
+void __msan_unpoison(void *, size_t);
+
 /**
  * GStatBuf:
  *
@@ -1344,7 +1346,9 @@ g_stat (const gchar *filename,
 
   return retval;
 #else
-  return stat (filename, buf);
+  int res = stat(filename, buf);
+  __msan_unpoison(buf, sizeof(struct stat));
+  return res;
 #endif
 }
 
@@ -1374,7 +1378,9 @@ g_lstat (const gchar *filename,
 {
 #ifdef HAVE_LSTAT
   /* This can't be Win32, so don't do the widechar dance. */
-  return lstat (filename, buf);
+  int res = lstat(filename, buf);
+  __msan_unpoison(buf, sizeof(struct stat));
+  return res;
 #elif defined (G_OS_WIN32)
   GWin32PrivateStat w32_buf;
   int retval = g_win32_lstat_utf8 (filename, &w32_buf);
diff --git a/glib/gstdio.h b/glib/gstdio.h
