diff --git a/glib/giounix.c b/glib/giounix.c
index 84e8135..8f33a0c 100644
--- a/glib/giounix.c
+++ b/glib/giounix.c
@@ -584,6 +584,8 @@ g_io_channel_new_file (const gchar *filename,
   return channel;
 }
 
+void __msan_unpoison(void *, size_t);
+
 /**
  * g_io_channel_unix_new:
  * @fd: a file descriptor.
@@ -631,10 +633,11 @@ g_io_channel_unix_new (gint fd)
   /* Newer UNIX versions support S_ISSOCK(), fstat() will probably
