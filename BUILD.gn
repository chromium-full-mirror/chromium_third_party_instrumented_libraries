import("//build/config/sanitizers/sanitizers.gni")
import("//build/symlink.gni")

declare_args() {
  instrumented_libraries_release = "resolute"
}

if (prebuilt_instrumented_libraries_available) {
  if (msan_track_origins == 0) {
    archive = "msan-no-origins-$instrumented_libraries_release-lib"
  } else if (msan_track_origins == 2) {
    archive = "msan-chained-origins-$instrumented_libraries_release-lib"
  }

  _ld_linux =
      "third_party/instrumented_libs/binaries/$archive/ld/ld-linux-x86-64.so.2"
  _lib_dir = "third_party/instrumented_libs/binaries/$archive/lib"

  copy("ld-linux") {
    sources = [ "//$_ld_linux" ]
    outputs = [ "$root_build_dir/$_ld_linux" ]
  }

  symlink("lib") {
    source = "//$_lib_dir"
    output = "$root_build_dir/$_lib_dir"
    deps = [ ":ld-linux" ]
  }

  # When prebuilt instrumented libraries are used, we need to tell those built
  # binaries need to load the following libraries via BUILD.gn configs so that
  # siso uploads these files to remote workers.
  config("msan_runtime_libs") {
    inputs = [
      "//$root_build_dir/third_party/instrumented_libs/binaries/$archive/ld/ld-linux-x86-64.so.2",
      "binaries/$archive/lib/libc.so.6",
      "binaries/$archive/lib/libdl.so.2",
      "binaries/$archive/lib/libgcc_s.so.1",
      "binaries/$archive/lib/libm.so.6",
      "binaries/$archive/lib/libpthread.so.0",
      "binaries/$archive/lib/libresolv.so.2",
      "binaries/$archive/lib/librt.so.1",
    ]
  }

  config("prebuilt_ldflags") {
    ldflags = [
      # Add a relative RPATH entry to Chromium binaries. This puts instrumented
      # DSOs before system-installed versions in library search path.
      "-Wl,-R,\$ORIGIN/../../third_party/instrumented_libs/binaries/$archive/lib",
      "-Wl,-z,origin",

      # Add some padding to allow RPATHs to be modified later.
      "-Wl,-R,________________________________________________________________________________________________PADDING________________________________________________________________________________________________",

      # Ensure the instrumented_libraries-provided ld.so is used.
      "-Wl,--dynamic-linker=third_party/instrumented_libs/binaries/$archive/ld/ld-linux-x86-64.so.2",
    ]
  }
}

group("deps") {
  if (use_locally_built_instrumented_libraries) {
    deps = [ "//third_party/instrumented_libs/$instrumented_libraries_release:locally_built" ]
  } else if (use_prebuilt_instrumented_libraries) {
    assert(prebuilt_instrumented_libraries_available,
           "Prebuilt instrumented libraries are only available when " +
               "is_msan = true and msan_track_origins = {0, 2}")
    data = [
      "//$_ld_linux",
      "//third_party/instrumented_libs/binaries/$archive/lib",

      # Declare ld-linux as a data dependency so it gets included by mb.py zip.
      "$root_build_dir/$_ld_linux",
    ]
    deps = [
      ":ld-linux",
      ":lib",
    ]
  }
}

config("locally_built_ldflags") {
  ldflags = [
    # Add a relative RPATH entry to Chromium binaries. This puts instrumented
    # DSOs before system-installed versions in library search path.
    "-Wl,-R,\$ORIGIN/instrumented_libraries/lib",
    "-Wl,-z,origin",

    # Add some padding to allow RPATHs to be modified later.
    "-Wl,-R,________________________________________________________________PADDING________________________________________________________________",

    # Ensure the instrumented_libraries-provided ld.so is used.
    "-Wl,--dynamic-linker=instrumented_libraries/ld/ld-linux-x86-64.so.2",
  ]
}
